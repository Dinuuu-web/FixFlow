# ==============================================================================
# FixFlow - .gitignore
# Java Spring Boot & Maven Project
# ==============================================================================

# Compiled class files and Maven build output
target/
*.class

# Package files
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Log files and directories
*.log
logs/
*.log.*

# User uploads & runtime storage (never commit user-submitted files)
uploads/
/uploads

# Environment variables & local secrets
.env
.env.*
!.env.example
application-local.properties
application-local.yml
application-local.yaml
application-secrets.properties
application-secrets.yml
application-secrets.yaml

# Local database dumps and backups
*.sql
*.sql.gz
*.dump
*.db
*.sqlite

# Private certificates, keys, and keystores
*.keystore
*.jks
*.p12
*.pfx
*.pem
*.key
*.crt
*.cer

# IDE - IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# IDE - Eclipse
.apt_generated
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache/

# IDE - Visual Studio Code
.vscode/

# IDE - NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbproject/genfiles.properties
/nodepool/

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Temporary files and editor backups
*.tmp
*.bak
*.swp
*~
scratch/

# Maven Wrapper binaries (preserve scripts: mvnw and mvnw.cmd)
!.mvn/wrapper/maven-wrapper.jar
